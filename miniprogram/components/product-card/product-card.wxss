/* product-card.wxss */
.product-card {
  width: 100%;
  border-radius: var(--radius-xl, 24rpx);
  border: none;
  overflow: hidden;
  box-sizing: border-box;
}

/* Grid 布局默认样式 */
.layout-grid {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.layout-grid .image-wrapper {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  background-color: var(--gray-100);
}

.layout-grid .info-content {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}

/* List 布局样式 */
.layout-list {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
  height: 240rpx;
}

.layout-list .image-wrapper {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  position: relative;
  background-color: var(--gray-100);
}

.layout-list .info-content {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  min-width: 0; /* 防止文本溢出 */
}

/* 共有样式 */
.active-scale {
  transition: transform 0.1s ease;
}
.active-scale:active {
  transform: scale(0.98);
}

.cover-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.platform-badge {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 50%;
  color: #fff;
  z-index: 10;
}
.pos-top-left {
  top: 12rpx;
  left: 12rpx;
}
.pos-bottom-right {
  bottom: 12rpx;
  right: 12rpx;
}

.promo-tag {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 10;
}
.bg-jd {
  background-color: var(--jd-red);
}
.bg-brand {
  background-color: var(--brand-color);
}

/* 排名角标 */
.rank-badge {
  position: absolute;
  top: 0;
  left: 0;
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  font-style: italic;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-right-radius: 16rpx;
  z-index: 10;
}
.rank-1 {
  background: linear-gradient(135deg, #FFD700, #FFAA00); /* 金 */
  box-shadow: 0 4rpx 8rpx rgba(255, 215, 0, 0.4);
}
.rank-2 {
  background: linear-gradient(135deg, #E0E0E0, #9E9E9E); /* 银 */
}
.rank-3 {
  background: linear-gradient(135deg, #FFB07C, #D87A4F); /* 铜 */
}

.title-row {
  line-height: 40rpx;
  min-height: 80rpx;
}

.card-bottom {
  margin-top: 12rpx;
}

.price-orig {
  margin-left: 8rpx;
}



.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mt-1 { margin-top: 4rpx; }

/* === 排名奖章 === */
.rank-gold { background: linear-gradient(135deg, #FFD700, #FFAA00); }
.rank-silver { background: linear-gradient(135deg, #A0B0C0, #708090); }
.rank-bronze { background: linear-gradient(135deg, #FF6A00, #D84A00); }

/* === 火力值 === */
.fire-value {
  color: #FF4500;
  font-size: 20rpx;
}

/* === 平台角标颜色 === */
.badge-taobao { background-color: #FF6200; }
.badge-jd { background-color: #E53E3E; }

/* === 促销标签 === */
.promo-tag {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 10;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-bottom-left-radius: 16rpx;
  background-color: #FF6200;
}

/* === 省钱标签 === */
.save-badge {
  background-color: #FFF0E5;
  color: #FF6200;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* === 动作按钮 (抢) === */
.action-btn {
  background: linear-gradient(135deg, #FF6200 0%, #FF3B00 100%);
  color: #FFFFFF;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(255, 98, 0, 0.3);
}

