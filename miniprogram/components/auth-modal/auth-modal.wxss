/* 极简授权弹窗统一样式 */
.auth-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

.auth-content {
  position: relative;
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: modalScale 0.3s ease-out;
}

@keyframes modalScale {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.auth-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.auth-subtitle {
  font-size: 24rpx;
  color: #999999;
}

.auth-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.auth-avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  padding: 0 !important;
  background: none !important;
  border-radius: 80rpx !important;
  margin-bottom: 40rpx !important;
  position: relative;
  overflow: visible;
}

.auth-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid #E5E5E5;
}

.auth-input-group {
  width: 100%;
  height: 96rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.auth-input-label {
  font-size: 30rpx;
  color: #333333;
  width: 100rpx;
}

.auth-nickname-input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  text-align: left;
}

.auth-footer {
  width: 100%;
  display: flex;
  justify-content: space-between;
}

.auth-cancel-btn {
  width: 230rpx !important;
  height: 88rpx !important;
  background-color: #F5F5F5 !important;
  color: #666666 !important;
  font-size: 32rpx !important;
  font-weight: 500 !important;
  border-radius: 44rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: none !important;
  margin: 0 !important;
}

.auth-confirm-btn {
  width: 230rpx !important;
  height: 88rpx !important;
  background-color: #FF6B35 !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 500 !important;
  border-radius: 44rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: none !important;
  margin: 0 !important;
}
