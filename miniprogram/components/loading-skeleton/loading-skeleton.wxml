<view class="skeleton-wrap">
  <!-- 列表模式骨架屏 -->
  <block wx:if="{{type === 'list'}}">
    <view class="skeleton-item-list" wx:for="{{items}}" wx:key="index">
      <view class="skeleton-img skeleton-anim"></view>
      <view class="skeleton-info">
        <view class="skeleton-title skeleton-anim"></view>
        <view class="skeleton-title-short skeleton-anim"></view>
        <view class="skeleton-bottom flex flex-row justify-between mt-auto">
          <view class="skeleton-price skeleton-anim"></view>
          <view class="skeleton-btn skeleton-anim"></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 网格模式骨架屏 -->
  <block wx:if="{{type === 'grid'}}">
    <view class="skeleton-grid">
      <view class="skeleton-item-grid" wx:for="{{items}}" wx:key="index">
        <view class="skeleton-img skeleton-anim"></view>
        <view class="skeleton-info-grid">
          <view class="skeleton-title skeleton-anim"></view>
          <view class="skeleton-title-short skeleton-anim"></view>
          <view class="skeleton-price-grid skeleton-anim mt-2"></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 详情页骨架屏 -->
  <block wx:if="{{type === 'detail'}}">
    <view class="skeleton-detail">
      <view class="skeleton-img skeleton-anim" style="width: 100%; height: 750rpx; border-radius: 0;"></view>
      <view style="padding: 30rpx;">
        <view class="skeleton-title skeleton-anim" style="width: 80%; height: 40rpx; margin-bottom: 20rpx;"></view>
        <view class="skeleton-title-short skeleton-anim" style="width: 60%; height: 40rpx; margin-bottom: 40rpx;"></view>
        <view class="skeleton-price skeleton-anim" style="width: 200rpx; height: 60rpx; margin-bottom: 30rpx;"></view>
        <view class="skeleton-title skeleton-anim" style="width: 100%; height: 24rpx; margin-bottom: 16rpx;"></view>
        <view class="skeleton-title skeleton-anim" style="width: 90%; height: 24rpx;"></view>
      </view>
    </view>
  </block>
</view>
