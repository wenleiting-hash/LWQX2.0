.skeleton-wrap {
  width: 100%;
  box-sizing: border-box;
}

/* 动画效果 */
@keyframes skeleton-blink {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton-anim {
  background: linear-gradient(90deg, var(--gray-100) 25%, var(--gray-200) 37%, var(--gray-100) 63%);
  background-size: 400% 100%;
  animation: skeleton-blink 1.4s ease infinite;
}

/* 列表模式 */
.skeleton-item-list {
  display: flex;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--radius-xl);
  margin-bottom: 24rpx;
}

.skeleton-item-list .skeleton-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.skeleton-item-list .skeleton-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 网格模式 */
.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-item-grid {
  width: 48%;
  background: #fff;
  border-radius: var(--radius-xl);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.skeleton-item-grid .skeleton-img {
  width: 100%;
  padding-bottom: 100%;
}

.skeleton-info-grid {
  padding: 16rpx;
}

/* 通用元素 */
.skeleton-title {
  height: 32rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  width: 100%;
}

.skeleton-title-short {
  height: 32rpx;
  border-radius: 8rpx;
  width: 60%;
}

.skeleton-price {
  height: 40rpx;
  width: 120rpx;
  border-radius: 8rpx;
}

.skeleton-price-grid {
  height: 36rpx;
  width: 100rpx;
  border-radius: 8rpx;
}

.skeleton-btn {
  height: 48rpx;
  width: 100rpx;
  border-radius: var(--radius-md);
}

.mt-auto { margin-top: auto; }
.mt-2 { margin-top: 16rpx; }
