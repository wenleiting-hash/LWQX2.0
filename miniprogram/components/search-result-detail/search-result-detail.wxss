/* components/search-result-detail/search-result-detail.wxss */
/* Flex utils */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.items-baseline { align-items: baseline; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }

.relative { position: relative; }
.w-full { width: 100%; }
.h-full { height: 100%; }
.overflow-hidden { overflow: hidden; }

/* 结构布局依据设计稿 j688s */
.result-card {
  width: 100%;
  box-sizing: border-box;
  padding: 34rpx; /* 约 16.9px */
  border-radius: 28rpx; /* 14px */
  border: 1px solid #f3f4f6;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05), 0 2rpx 2rpx rgba(0,0,0,0.1); 
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 15.99px */
}

/* 顶部图片+简述 (Container Euu9r) */
.content-row {
  height: 202rpx; /* 101.3px */
  gap: 24rpx; /* 11.9px */
}

/* Image (Container EimOs) */
.img-wrap {
  width: 192rpx; /* 95.9px */
  height: 192rpx;
  border-radius: 20rpx; /* 10px */
  overflow: hidden;
  border: 1px solid #f3f4f6;
}

.object-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* Info Column (Container vTcgK) */
.info-col {
  height: 202rpx;
  padding: 8rpx 0; /* 3.99px 居中上下 */
}

/* Title (HwjwP) */
.title-text {
  font-size: 28rpx; /* 14px */
  font-weight: 700;
  color: var(--brand-primary);
  line-height: 1.375;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 价格与优惠区 */
.price-section {
  flex: 1;
  gap: 8rpx;
}

/* 价格行 */
.price-row {
  gap: 8rpx; /* 4px */
}

.price-current {
  font-size: 36rpx; /* 18px */
  font-weight: 700;
  color: var(--accent-red);
  line-height: 1.5;
}

.price-origin {
  font-size: 24rpx; /* 12px */
  font-weight: normal;
  color: #8E8E93;
  text-decoration: line-through;
}

/* 省钱标签 gQ3Zn */
.save-chip {
  height: 38rpx; /* 18.9px */
  padding: 0 12rpx;
  background-color: #fef2f2;
  border-radius: 8rpx; /* 4px */
  font-size: 20rpx; /* 10px */
  color: var(--accent-red);
  font-weight: normal;
}

/* 按钮 3tuiK */
.buy-btn {
  height: 88rpx; /* 43.9px */
  background-color: var(--brand-primary);
  border-radius: 20rpx; /* 10px */
  font-size: 28rpx; /* 14px */
  font-weight: 700;
  padding: 0;
  margin: 0;
  line-height: normal;
  box-shadow: 0 4rpx 4rpx rgba(0,0,0,0.1), 0 8rpx 8rpx -2rpx rgba(0,0,0,0.1); 
}

.buy-btn::after { display: none; }
.buy-btn:active { transform: scale(0.95); }

/* Animation */
.fade-zoom-in {
  animation: fadeZoomIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes fadeZoomIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
