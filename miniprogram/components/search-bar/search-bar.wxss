.search-bar-wrap {
  padding: 16rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.search-box {
  height: 72rpx;
  padding: 0 8rpx 0 24rpx;
  background-color: var(--gray-100);
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1px solid rgba(255, 85, 0, 0.1);
}

.icon-wrap {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-icon {
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

.search-input, .search-text {
  height: 100%;
  line-height: 72rpx;
  font-size: 28rpx;
  flex: 1;
}

.search-text {
  color: var(--gray-400);
}

.clear-wrap {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: var(--gray-300);
  color: #fff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.search-btn {
  width: 100rpx;
  height: 56rpx;
  background-image: linear-gradient(to right, var(--brand-gradient-start), var(--brand-gradient-end));
  border-radius: 999rpx;
  margin-left: 8rpx;
}
