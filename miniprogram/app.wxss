/**
 * 全局样式表 - LWQX 3.0
 * 纯手工提纯的 Tailwind 原子类（微信小程序兼容版）
 */

@import "style/weui.wxss";

page {
  /* ===== LWQX 3.0 品牌色体系 ===== */
  --brand-primary: #FF6200;
  --brand-danger: #F33300;
  --bg-global: #F8F8F8;
  --text-primary: #000000;
  --text-secondary: #646464;
  
  /* ===== Tailwind 兼容变量 ===== */
  --brand-color: #FF6200;
  --gray-100: #F2F2F2;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #A6A6A6;
  
  /* ===== 渐变 & 功能色 ===== */
  --brand-gradient-start: #FF6200;
  --brand-gradient-end: #FF8A2B;
  --success-green: #52C41A;

  /* ===== 2.0 兼容别名 ===== */
  --accent-red: var(--brand-danger);
  --bg-gray: var(--bg-global);

  background-color: var(--bg-global);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  box-sizing: border-box;
}

view, text, image, scroll-view, input, button, textarea {
  box-sizing: border-box;
}

/* === 布局 === */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }
.w-full { width: 100%; }
.h-full { height: 100%; }

/* === 文本 === */
.text-xs { font-size: 24rpx; line-height: 1.5; }
.text-sm { font-size: 28rpx; line-height: 1.5; }
.text-base { font-size: 32rpx; line-height: 1.5; }
.text-lg { font-size: 36rpx; line-height: 1.5; }
.text-xl { font-size: 40rpx; line-height: 1.5; }
.text-2xl { font-size: 48rpx; line-height: 1.5; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }

.text-white { color: #ffffff; }
.text-gray-400 { color: #A6A6A6; }
.text-gray-500 { color: #A6A6A6; }
.text-gray-600 { color: #646464; }
.text-gray-900 { color: #000000; }
.text-brand { color: var(--brand-primary); }

.text-center { text-align: center; }
.text-left { text-align: left; }
.line-through { text-decoration: line-through; }

/* === 截断 === */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.line-clamp-1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* === 背景 === */
.bg-white { background-color: #ffffff; }
.bg-brand { background-color: var(--brand-primary); }
.bg-gray-50 { background-color: #f9fafb; }
.bg-gray-100 { background-color: #f3f4f6; }
.bg-gray-200 { background-color: #e5e7eb; }

/* === 圆角 === */
.rounded-sm { border-radius: 4rpx; }
.rounded-md { border-radius: 8rpx; }
.rounded-lg { border-radius: 16rpx; }
.rounded-xl { border-radius: 24rpx; }
.rounded-full { border-radius: 9999rpx; }

/* === 阴影 === */
.shadow-sm { box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.shadow-md { box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.06); }

/* === 定位 === */
.relative { position: relative; }
.absolute { position: absolute; }
.overflow-hidden { overflow: hidden; }

/* === 安全区 === */
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }
.pb-24 { padding-bottom: calc(96rpx + env(safe-area-inset-bottom)); }

/* === 清除 button 默认样式 === */
.clear-btn {
  background-color: transparent;
  padding: 0;
  margin: 0;
  line-height: inherit;
  border-radius: 0;
}
.clear-btn::after {
  display: none;
}

/* === 自动补充的 Tailwind 类 === */
.pt-10 { padding-top: 80rpx; }
.pb-2 { padding-bottom: 16rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.pt-6 { padding-top: 48rpx; }
.px-3 { padding-left: 24rpx; padding-right: 24rpx; }
.mr-2 { margin-right: 16rpx; }
.mt-4 { margin-top: 32rpx; }
.mb-10 { margin-bottom: 80rpx; }
.mt-8 { margin-top: 64rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-2 { margin-bottom: 16rpx; }
.bottom-6 { bottom: 48rpx; }
.px-6 { padding-left: 48rpx; padding-right: 48rpx; }
.py-2 { padding-top: 16rpx; padding-bottom: 16rpx; }
.mb-4 { margin-bottom: 32rpx; }
.p-4 { padding: 32rpx; }
.mb-6 { margin-bottom: 48rpx; }
.p-6 { padding: 48rpx; }
.mb-8 { margin-bottom: 64rpx; }
.h-8 { height: 64rpx; }
.h-48 { height: 384rpx; }
.w-full { width: 100%; }
.min-h-screen { min-height: 100vh; }
.bg-orange-50 { background-color: #FFF7ED; }
.bg-blue-50 { background-color: #EFF6FF; }
.bg-green-50 { background-color: #F0FDF4; }
.rounded-t-3xl { border-top-left-radius: 48rpx; border-top-right-radius: 48rpx; }
.break-all { word-break: break-all; }
.text-gray-700 { color: #374151; }
.py-3 { padding-top: 24rpx; padding-bottom: 24rpx; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }
.py-20 { padding-top: 160rpx; padding-bottom: 160rpx; }
.text-4xl { font-size: 72rpx; line-height: 1.5; }
.text-6xl { font-size: 96rpx; line-height: 1.5; }
.opacity-0 { opacity: 0; }
.opacity-50 { opacity: 0.5; }
.opacity-100 { opacity: 1; }
.scale-x-0 { transform: scaleX(0); }

/* 点击微交互 */
.active-scale { transform: scale(0.96); transition: transform 0.1s ease; }

.transition-all { transition-property: all; }
.duration-300 { transition-duration: 300ms; }
.w-8 { width: 64rpx; }
.h-1 { height: 8rpx; }
.w-px { width: 1px; }
.border { border-width: 1px; }
.border-b { border-bottom-width: 1px; }
.border-gray-100 { border-color: #F3F4F6; }
.border-gray-200 { border-color: #E5E7EB; }
.top-0 { top: 0; }
.z-50 { z-index: 50; }
.sticky { position: sticky; }
.-translate-x-half { transform: translateX(-50%); }

.top-half { top: 50%; }
.bg-gray-900-80 { background-color: rgba(17, 24, 39, 0.8); }
.border-brand-20 { border-color: rgba(255, 85, 0, 0.2); }

