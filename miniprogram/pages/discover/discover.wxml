<view class="discover-container pb-safe">
  
  <!-- Search Bar -->
  <view class="search-container">
    <view class="search-bar-wrapper">
      <view class="search-platform-prefix" bindtap="switchSearchPlatform">
        <text class="prefix-text">{{searchPlatform === 'tb' ? '淘券' : '京券'}}</text>
        <view class="prefix-arrow"></view>
      </view>
      <view class="search-bar-inner">
        <input class="search-input" placeholder="搜索商品，查找大额优惠券" placeholder-class="placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" confirm-type="search" />
        <view class="icon-clear" wx:if="{{searchKeyword.length > 0}}" bindtap="onClear" style="margin-right: 12rpx;"></view>
        <view class="icon-search search-icon" bindtap="doSearch"></view>
      </view>
    </view>
  </view>



  <!-- Main Content -->
  <view class="content-wrapper">
    
    <!-- Grid Menu (金刚区) -->
    <view class="grid-menu-card shadow-card">
      <block wx:if="{{!isLoading}}">
        <view class="grid-menu">
          <view class="grid-item" wx:for="{{icons}}" wx:key="id" bindtap="goToCategoryList" data-item="{{item}}" hover-class="opacity-80 scale-98">
            <view class="icon-wrapper" style="background-color: {{item.bgColor}};">
              <view class="icon-lucide {{item.iconClass}}" style="color: {{item.color}};" />
            </view>
            <text class="icon-text">{{item.name}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <!-- Skeleton Grid Menu -->
        <view class="grid-menu">
          <view class="grid-item" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this">
            <view class="skeleton-block icon-wrapper" style="border-radius: 28rpx;"></view>
            <view class="skeleton-block" style="width: 80rpx; height: 24rpx; margin-top: 4rpx;"></view>
          </view>
        </view>
      </block>
    </view>



    <!-- Centered Feed Platform Switch (Flat Tabs) -->
    <view class="feed-tabs-container">
      <view class="feed-tab {{feedPlatform === 'tb' ? 'active' : ''}}" bindtap="switchFeedPlatform" data-p="tb">
        <text>淘喜商品</text>
        <view class="tab-indicator" wx:if="{{feedPlatform === 'tb'}}"></view>
      </view>
      <view class="feed-tab {{feedPlatform === 'jd' ? 'active' : ''}}" bindtap="switchFeedPlatform" data-p="jd">
        <text>京喜商品</text>
        <view class="tab-indicator" wx:if="{{feedPlatform === 'jd'}}"></view>
      </view>
    </view>

    <!-- Product Waterfall (Masonry) -->
    <block wx:if="{{!isLoading}}">
      <view class="waterfall-grid">
        <view class="product-card" wx:for="{{products}}" wx:key="tao_id" bindtap="goToDetail" data-item="{{item}}" hover-class="opacity-90 scale-98" style="transition: transform 0.2s">
          <view class="image-wrapper">
            <image src="{{item.image_url}}" mode="widthFix" class="product-image" lazy-load="{{true}}" />
            <view class="platform-tag" style="background-color: {{themeColor || '#FF6200'}};">
              {{item.platform === 'taobao' ? '淘宝' : '京东'}}
            </view>
          </view>
          <view class="product-info">
            <view class="product-title line-clamp-2">{{item.title}}</view>
            <view class="price-section">
              <view class="coupon-tag" style="background-color: {{themeColor ? themeColor+'1A' : 'rgba(255,98,0,0.05)'}}; border-color: {{themeColor ? themeColor+'4D' : 'rgba(255,98,0,0.3)'}};" wx:if="{{item.coupon_amount > 0}}">
                <text class="coupon-txt" style="color: {{themeColor || '#FF6200'}};">券</text>
                <text class="coupon-val" style="color: {{themeColor || '#FF6200'}};">¥{{item.coupon_amount}}</text>
              </view>
              <view class="price-row">
                <view class="final-price" style="color: {{themeColor || '#FF6200'}};">
                  <text class="price-symbol">¥</text>
                  <text class="price-num">{{item.coupon_price}}</text>
                </view>
                <text class="original-price" wx:if="{{item.original_price > item.coupon_price}}">¥{{item.original_price}}</text>
              </view>
              <view class="sales-row">
                <text class="sales-text">已售 {{item.sales_num}}</text>
                <view class="buy-btn" style="color: {{themeColor || '#FF6200'}};">领券抢购 ></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <!-- Skeleton Waterfall -->
      <view class="waterfall-grid">
        <view class="product-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="skeleton-block" style="height: 340rpx; border-radius: 0;"></view>
          <view class="product-info" style="padding-top: 24rpx;">
            <view class="skeleton-block" style="width: 100%; height: 28rpx; margin-bottom: 12rpx;"></view>
            <view class="skeleton-block" style="width: 70%; height: 28rpx; margin-bottom: 24rpx;"></view>
            <view class="skeleton-block" style="width: 80rpx; height: 32rpx; margin-bottom: 16rpx; border-radius: 8rpx;"></view>
            <view style="display: flex; justify-content: space-between;">
              <view class="skeleton-block" style="width: 120rpx; height: 36rpx;"></view>
              <view class="skeleton-block" style="width: 80rpx; height: 24rpx;"></view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- Bottom Loading Indicators -->
    <view class="flex justify-center items-center py-6" wx:if="{{isLoadingMore}}">
      <text class="text-xs text-gray-400">正在加载更多...</text>
    </view>
    <view class="flex justify-center items-center py-6" wx:if="{{!hasMore && products.length > 0}}">
      <text class="text-xs text-gray-300">已经到底啦~</text>
    </view>

  </view>
</view>
