/* ===== Discover Page ===== */

.discover-container {
  min-height: 100vh;
  background-color: #FEF8F4;
  display: flex;
  flex-direction: column;
}

/* --- Header & Search Container --- */
.search-container {
  padding: 12rpx 32rpx 24rpx 32rpx;
  background-color: #FEF8F4;
}

/* Unified Search Pill */
.search-bar-wrapper {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 999rpx;
  height: 80rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-platform-prefix {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
  margin-right: 20rpx;
  gap: 8rpx;
  position: relative;
}

/* Optional vertical divider */
.search-platform-prefix::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 28rpx;
  background-color: #EEEEEE;
}

.prefix-text {
  color: #333333;
  font-size: 30rpx;
  font-weight: 500;
}

.prefix-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #333333;
  margin-top: 4rpx;
}

/* Search Inner Content */
.search-bar-inner {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.placeholder {
  color: #999999;
  font-size: 26rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  background-color: #333333;
}

/* --- Main Content Area --- */
.content-wrapper {
  padding: 0 32rpx;
  margin-top: 16rpx;
  flex: 1;
}

/* Grid Menu (金刚区) */
.grid-menu-card {
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 32rpx;
}

.shadow-card {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
}

.grid-menu {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 40rpx;
  column-gap: 16rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
}

.icon-lucide {
  width: 44rpx;
  height: 44rpx;
}

.icon-text {
  color: #666666;
  font-size: 24rpx;
  font-weight: 500;
}



/* --- Centered Feed Platform Switch (Flat Tabs) --- */
.feed-tabs-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 32rpx;
  gap: 64rpx;
}

.feed-tab {
  position: relative;
  font-size: 30rpx;
  color: #999999;
  font-weight: 500;
  padding-bottom: 12rpx;
  transition: all 0.3s ease;
}

.feed-tab.active {
  color: #333333;
  font-weight: bold;
  font-size: 32rpx;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF7A00, #FF5000);
  border-radius: 6rpx;
}

/* Waterfall Grid (Masonry using CSS column-count) */
.waterfall-grid {
  column-count: 2;
  column-gap: 16rpx;
}

.product-card {
  break-inside: avoid;
  margin-bottom: 16rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.image-wrapper {
  position: relative;
  width: 100%;
  background-color: #F5F5F5;
}

.product-image {
  width: 100%;
  display: block; /* removes bottom margin in some engines */
}

.platform-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.tag-tb { background-color: #FF5000; }
.tag-jd { background-color: #E1251B; }

.product-info {
  padding: 20rpx;
}

.product-title {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.4;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.coupon-tag {
  display: inline-flex;
  align-items: center;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.coupon-txt { font-weight: normal; }
.coupon-val { font-weight: bold; }

.price-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.final-price {
  font-weight: bold;
  font-size: 28rpx;
}

.price-symbol { font-size: 22rpx; }

.original-price {
  color: #CCCCCC;
  font-size: 22rpx;
  text-decoration: line-through;
  padding-bottom: 2rpx;
}

.sales-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.sales-text {
  color: #999999;
  font-size: 22rpx;
}

.buy-btn {
  font-size: 22rpx;
  font-weight: 500;
}

.buy-btn {
  font-size: 22rpx;
  font-weight: 500;
}

/* --- Skeleton Loading --- */
.skeleton-block {
  background: linear-gradient(90deg, #F0F0F0 25%, #E5E5E5 37%, #F0F0F0 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* Utilities */
.opacity-80 { opacity: 0.8; }
.scale-98 { transform: scale(0.98); }
.pb-safe { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

