<view class="home-container">
  
  <!-- 极简顶部导航栏 -->
  <view class="custom-nav-bar">
    <view class="status-bar" style="height: {{statusBarHeight || 44}}px;"></view>
    <view class="title-bar" style="height: 44px; justify-content: center;">
      <text class="title-text-simple">小栗鼠</text>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y="true">
    <view class="content-wrapper-center">
      
      <!-- 居中的大 Logo -->
      <view class="logo-section">
        <view class="big-logo-wrap">
          <image class="big-logo" src="../../images/logo.png" mode="aspectFit" />
        </view>
      </view>

      <!-- 一体化搜索卡片 -->
      <view class="search-card-integrated elevated">
        <view class="textarea-wrapper">
          <textarea 
            class="search-textarea" 
            placeholder="请长按粘贴淘宝/京东商品链接或口令" 
            placeholder-class="placeholder-text"
            value="{{inputValue}}" 
            bindinput="onInput"
            maxlength="800"
            disable-default-padding="true"
          ></textarea>
          <view class="clear-input-btn" wx:if="{{inputValue.length > 0}}" bindtap="onClearInput" style="position: absolute; right: 20rpx; bottom: 20rpx; z-index: 10; padding: 10rpx;">
            <icon type="clear" size="18" color="#ccc"/>
          </view>
        </view>
        <view class="search-btn-integrated" hover-class="btn-active" bindtap="onSearch">
          <text class="search-btn-text">一键查券</text>
        </view>
      </view>

      <!-- 扁平化横向引导流程 -->
      <view class="guide-flow">
        <view class="flow-item">
          <view class="flow-icon-wrap"><text class="flow-num">1</text></view>
          <text class="flow-text">复制商品链接</text>
        </view>
        <view class="flow-arrow">
          <view class="icon-arrow-mini"></view>
        </view>
        <view class="flow-item">
          <view class="flow-icon-wrap"><text class="flow-num">2</text></view>
          <text class="flow-text">打开小栗鼠</text>
        </view>
        <view class="flow-arrow">
          <view class="icon-arrow-mini"></view>
        </view>
        <view class="flow-item">
          <view class="flow-icon-wrap"><text class="flow-num">3</text></view>
          <text class="flow-text">一键查券省钱</text>
        </view>
      </view>
      
    </view>
  </scroll-view>

  <!-- 智能截获弹窗 Modal -->
  <view class="modal-overlay" wx:if="{{showClipboard}}">
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-icon-bg">
          <view class="icon-gift"></view>
        </view>
        <view class="modal-title font-bold">发现专属优惠</view>
      </view>
      <view class="modal-body">
        <view class="modal-desc line-clamp-2">{{clipboardText}}</view>
      </view>
      <view class="modal-btn-wrap w-full flex flex-col gap-2">
        <view class="modal-btn confirm-btn" hover-class="btn-active" bindtap="onSearch">立即查券</view>
        <view class="modal-btn ignore-btn" bindtap="onIgnoreClipboard">取消</view>
      </view>
    </view>
  </view>

  <!-- 查券结果弹窗 Modal -->
  <view class="modal-overlay" wx:if="{{showResultModal}}">
    <view class="modal-content result-modal">
      <!-- 右上角关闭 X -->
      <view class="modal-close-btn" bindtap="closeResultModal">
        <text class="modal-close-icon">×</text>
      </view>

      <block wx:if="{{!showCopyGuide}}">
        <!-- 商品信息区（有商品数据时才展示） -->
        <view class="result-goods-info" wx:if="{{resultModalData.title}}">
          <image class="result-goods-img" src="{{resultModalData.image_url}}" mode="aspectFill"></image>
          <view class="result-goods-title line-clamp-2">{{resultModalData.title}}</view>
        </view>

        <!-- 提示语区域 -->
        <view class="result-compliance-msg">
          <!-- 有券 -->
          <block wx:if="{{resultModalData.hasCoupon}}">
            <text>恭喜，该商品查到更多优惠，您可复制后返回原APP下单。</text>
          </block>
          <!-- 无券 -->
          <block wx:else>
            <text>很遗憾，该商品暂无更多优惠，您可复制后返回原APP下单。</text>
          </block>
        </view>

        <!-- 按钮区域 -->
        <view class="modal-btn-wrap w-full flex flex-col gap-2">
          <view 
            class="modal-btn confirm-btn" 
            bindtap="{{resultModalData.platform === 'jd' ? 'copyAndOpenJd' : 'copyAndOpenTaobao'}}">
            复制返回原APP下单
          </view>
          <view class="modal-btn ignore-btn" bindtap="closeResultModal">取消</view>
        </view>
      </block>

      <!-- 复制成功后的引导页 -->
      <block wx:else>
        <view class="copy-guide-wrap flex flex-col items-center gap-4 py-6 w-full">
          <icon type="success" size="64" color="#07C160"></icon>
          <view class="font-bold text-lg mt-2">复制成功！</view>
          <view class="text-gray-500 text-center leading-relaxed">
            <text>优惠口令已保存至剪贴板\n请直接打开 <text class="font-bold text-orange-500">{{resultModalData.platform === 'jd' ? '京东' : '手机淘宝'}}</text> App\n等待几秒即可自动弹出口令</text>
          </view>
          <view class="modal-btn confirm-btn w-full mt-6" bindtap="closeResultModal">我知道了</view>
        </view>
      </block>
    </view>
  </view>

</view>
