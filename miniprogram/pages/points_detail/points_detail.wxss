page {
  background-color: #F5F5F5;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.content-area {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.top-card {
  background: linear-gradient(90deg, #FF6B35 0%, #E55A2B 100%);
  border-radius: 28rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  color: #FFFFFF;
}

.top-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.top-value {
  font-size: 72rpx;
  font-weight: bold;
}

.tabs-row {
  display: flex;
  gap: 48rpx;
  padding: 0 8rpx;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tab-text {
  font-size: 30rpx;
  color: #888888;
}

.tab.active .tab-text {
  color: #191919;
  font-weight: 600;
}

.tab-line {
  width: 40rpx;
  height: 6rpx;
  background-color: #FF6B35;
  border-radius: 3rpx;
  margin-top: 8rpx;
}

/* 可以考虑给 active 加下划线指示器，但设计原稿没加就靠颜色区分 */

.list-area {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.item-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.item-time {
  font-size: 24rpx;
  color: #999999;
}

.item-right {
  font-size: 36rpx;
  font-weight: bold;
}

.item-right.pos {
  color: #FF6B35;
}

.item-right.neg {
  color: #333333;
}

.list-divider {
  height: 2rpx;
  background-color: #E5E5E5;
  width: 100%;
}
