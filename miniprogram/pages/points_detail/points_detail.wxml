<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">
  <view class="content-area">
    
    <!-- Top Card -->
    <view class="top-card">
      <text class="top-label">当前积分</text>
      <text class="top-value">{{currentPoints}}</text>
    </view>
    
    <!-- Tabs Row -->
    <view class="tabs-row">
      <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="onTabClick" data-type="all">
        <text class="tab-text">全部</text>
        <view class="tab-line" wx:if="{{activeTab === 'all'}}"></view>
      </view>
      <view class="tab {{activeTab === 'gain' ? 'active' : ''}}" bindtap="onTabClick" data-type="gain">
        <text class="tab-text">获取</text>
        <view class="tab-line" wx:if="{{activeTab === 'gain'}}"></view>
      </view>
      <view class="tab {{activeTab === 'cost' ? 'active' : ''}}" bindtap="onTabClick" data-type="cost">
        <text class="tab-text">消耗</text>
        <view class="tab-line" wx:if="{{activeTab === 'cost'}}"></view>
      </view>
    </view>
    
    <!-- List Area -->
    <view class="list-area">
      <block wx:for="{{filteredList}}" wx:key="id">
        <view class="list-item">
          <view class="item-left">
            <text class="item-title">{{item.title}}</text>
            <text class="item-time">{{item.time}}</text>
          </view>
          <text class="item-right {{item.amount > 0 ? 'pos' : 'neg'}}">{{item.amount > 0 ? '+ ' + item.amount : '- ' + (-item.amount)}}</text>
        </view>
        <view class="list-divider" wx:if="{{index < filteredList.length - 1}}"></view>
      </block>
      
      <view class="empty-box" wx:if="{{filteredList.length === 0}}">
        <text class="empty-text">暂无相关记录</text>
      </view>
    </view>

  </view>
</scroll-view>
