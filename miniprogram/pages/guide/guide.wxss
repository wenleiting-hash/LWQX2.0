/* ===== Guide Page ===== */
.container { min-height: 100vh; background-color: #FEF8F4; display: flex; flex-direction: column; }
.pb-safe { padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.scroll-content { flex: 1; padding: 32rpx; }

/* Header */
.page-header { text-align: center; margin-bottom: 48rpx; }
.header-title { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.header-desc { font-size: 26rpx; color: #999; }

/* Step Card */
.step-card { background-color: #FFFFFF; border-radius: 32rpx; padding: 32rpx; margin-bottom: 0; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.03); }
.step-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.step-num { width: 48rpx; height: 48rpx; border-radius: 50%; background: linear-gradient(135deg, #FF8C00, #FF6200); color: #FFF; font-size: 26rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-title { font-size: 30rpx; font-weight: bold; color: #333; }
.step-body {}
.step-desc { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 24rpx; display: block; }
.step-image-placeholder { width: 100%; height: 260rpx; background-color: #FFF5EE; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; border: 2rpx dashed rgba(255, 98, 0, 0.2); }
.placeholder-icon { font-size: 64rpx; }
.placeholder-text { font-size: 24rpx; color: #FFB380; font-weight: 500; }

/* Step Connector */
.step-connector { display: flex; flex-direction: column; align-items: center; height: 60rpx; }
.connector-line { width: 2rpx; flex: 1; background-color: #FFD4B8; }
.connector-arrow { color: #FF6200; font-size: 24rpx; font-weight: bold; }

/* Tips */
.tips-card { background-color: #FFFFFF; border-radius: 32rpx; padding: 32rpx; margin-top: 32rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.03); border: 2rpx solid #FFF5EE; }
.tips-title { font-size: 28rpx; font-weight: bold; color: #FF6200; margin-bottom: 16rpx; display: flex; align-items: center; gap: 8rpx; }
.tips-item { font-size: 24rpx; color: #666; line-height: 2; }

/* Bottom CTA */
.bottom-cta { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background-color: rgba(255, 255, 255, 0.9); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.03); z-index: 100; }
.cta-btn { background: linear-gradient(90deg, #FF8A2B, #FF6200); color: #FFF; font-size: 32rpx; font-weight: bold; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: 100rpx; box-shadow: 0 8rpx 24rpx rgba(255,98,0,0.3); transition: all 0.2s ease; }
.cta-btn-hover { transform: scale(0.95); opacity: 0.9; }
