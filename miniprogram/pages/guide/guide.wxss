page {
  background-color: #F5F5F5;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.content-area {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

.card-title {
  color: #FF6B35;
  font-size: 32rpx;
  font-weight: bold;
}

.qa-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.q-text {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.a-text {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
}

.contact-section {
  padding: 64rpx 0;
  display: flex;
  justify-content: center;
}

.contact-text {
  color: #888888;
  font-size: 26rpx;
}
