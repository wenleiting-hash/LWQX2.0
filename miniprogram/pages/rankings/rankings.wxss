/* ===== Rankings Page ===== */

.rankings-container {
  min-height: 100vh;
  background-color: #FEF8F4;
  display: flex;
  flex-direction: column;
}

/* --- Header --- */
.header-section {
  padding: 0 32rpx 96rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
  transition: background 0.3s ease;
}

/* Pill-shaped Switch (Platform) */
.hot-tabs-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 100rpx;
  padding: 8rpx;
  height: 80rpx;
  margin: 32rpx 40rpx 32rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
}

.hot-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  border-radius: 100rpx;
  transition: all 0.3s ease;
}

.hot-tab-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-active {
  background: #FF6200;
  box-shadow: 0 8rpx 24rpx rgba(255, 98, 0, 0.2);
}

.tab-active .hot-tab-text {
  color: #FFFFFF;
  font-weight: bold;
}

/* --- Main Content --- */
.main-content-wrapper {
  padding: 0 32rpx;
  margin-top: -50rpx;
  flex: 1;
}

/* Grid Nav (金刚区) */
.grid-nav-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
}

.grid-row {
  display: flex;
  margin-bottom: 32rpx;
}
.grid-row-4 {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx;
}

.grid-row-3-cards {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.row3-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  gap: 8rpx;
}

.row3-card-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.row3-card-text {
  font-size: 26rpx;
  font-weight: bold;
}

.row3-card-sub {
  font-size: 20rpx;
  color: #999999;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  transition: all 0.2s ease;
}

.active-icon {
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.icon-lucide {
  width: 44rpx;
  height: 44rpx;
}

.icon-text {
  font-size: 22rpx;
  transition: all 0.2s ease;
}

/* Item List */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-item {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  position: relative;
  overflow: hidden;
}

/* Big Number - Elegant / Minimalist */
.top-number {
  position: absolute;
  top: 0;
  left: 0;
  width: 48rpx;
  height: 48rpx;
  border-bottom-right-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 24rpx;
  color: #FFFFFF;
  z-index: 2;
}

.top-1 { 
  background-color: #1A1A1A;
}
.top-2 { 
  background-color: #666666;
}
.top-3 { 
  background-color: #999999;
}
.top-other { 
  background-color: #F5F5F5; 
  color: #B3B3B3; 
}

/* Image */
.item-img-wrapper {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #F5F5F5;
  position: relative;
  flex-shrink: 0;
}

.item-img {
  width: 100%;
  height: 100%;
}

.platform-tag {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-top-left-radius: 8rpx;
  color: #FFFFFF;
}

/* Info */
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.5;
  font-weight: 600;
  margin-bottom: auto;
}

.item-coupon-row {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.coupon-tag {
  display: inline-flex;
  align-items: center;
  border: 1rpx solid;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  gap: 4rpx;
}

.coupon-txt { font-weight: normal; }
.coupon-val { font-weight: bold; }

.item-price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-symbol { font-weight: bold; font-size: 22rpx; }
.price-val { font-weight: bold; font-size: 32rpx; }
.price-ori {
  color: #A6A6A6;
  font-size: 22rpx;
  text-decoration: line-through;
  opacity: 0.8;
}

.buy-btn {
  background-color: #FF6200;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 98, 0, 0.2);
}

/* Utilities */
.pb-safe { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

