/* ===== Secondary Ranking List Page ===== */

.ranking-list-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  display: flex;
  flex-direction: column;
}

/* --- Pill-shaped Switch (Platform) --- */
.hot-tabs-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 100rpx;
  padding: 8rpx;
  height: 80rpx;
  margin: 32rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hot-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  border-radius: 100rpx;
  transition: all 0.3s ease;
}

.hot-tab-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-active {
  background: linear-gradient(90deg, #FF8C00, #FF5A00);
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 0, 0.2);
}

.tab-active .hot-tab-text {
  color: #FFFFFF;
  font-weight: bold;
}

/* --- Sort Bar --- */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 80rpx;
  background-color: transparent;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: color 0.2s ease;
}

.sort-item.active {
  color: #FF6200;
  font-weight: bold;
}

.sort-arrows {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 2rpx;
}

.arrow-up, .arrow-down {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
}

.arrow-up {
  border-bottom: 8rpx solid #CCCCCC;
}

.arrow-down {
  border-top: 8rpx solid #CCCCCC;
}

.arrow-up.active-arrow { border-bottom-color: #FF6200; }
.arrow-down.active-arrow { border-top-color: #FF6200; }

/* --- Item List --- */
.rank-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-item {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  position: relative;
  overflow: hidden;
}

/* Big Number Indicator */
.top-number {
  position: absolute;
  top: 0;
  left: 0;
  width: 50rpx;
  height: 50rpx;
  border-bottom-right-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 24rpx;
  color: #FFFFFF;
  z-index: 2;
}

.top-1 { background-color: #1A1A1A; }
.top-2 { background-color: #666666; }
.top-3 { background-color: #999999; }
.top-other { background-color: #F5F5F5; color: #B3B3B3; }

/* Image */
.item-img-wrapper {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #F5F5F5;
  position: relative;
  flex-shrink: 0;
}

.item-img {
  width: 100%;
  height: 100%;
}

.platform-tag {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-top-left-radius: 8rpx;
  color: #FFFFFF;
}

/* Info */
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.5;
  font-weight: 600;
  margin-bottom: auto;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-coupon-row {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.coupon-tag {
  display: inline-flex;
  align-items: center;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  gap: 4rpx;
}

.coupon-txt { font-weight: normal; }
.coupon-val { font-weight: bold; }

.item-price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-symbol { font-weight: bold; font-size: 22rpx; }
.price-val { font-weight: bold; font-size: 32rpx; }
.price-ori {
  color: #A6A6A6;
  font-size: 22rpx;
  text-decoration: line-through;
  opacity: 0.8;
}

.buy-btn {
  background-color: #FF6200;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 98, 0, 0.3);
}

/* Loading & Empty States */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
}

.empty-state {
  text-align: center;
  padding: 48rpx 0;
  color: #9ca3af; /* gray-400 */
  font-size: 24rpx; /* text-xs */
}

.loading-more-state {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 8rpx solid #FF6200;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #FF6200;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 16rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.active-scale {
  transform: scale(0.98);
  opacity: 0.9;
}

.pb-safe { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
