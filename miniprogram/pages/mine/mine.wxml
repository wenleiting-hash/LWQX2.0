<view class="mine-container pb-safe">
  
  <!-- Header / Large Title -->
  <view class="page-header">
    <text class="page-title">省钱概览</text>
    <text class="page-subtitle">数据已实时同步，今天又是精打细算的一天</text>
  </view>
  
  <!-- Hero Stats Card -->
  <view class="hero-stats-card">
    <!-- Decorative background glow for a premium feel -->
    <view class="stats-bg-glow"></view>
    
    <view class="stats-content">
      <view class="stats-header">
        <text class="stats-label">累计发现优惠 (元)</text>
        <view class="tag-live">
          <view class="live-dot"></view>
          <text>实时</text>
        </view>
      </view>
      
      <view class="stats-body">
        <text class="currency">¥</text>
        <text class="amount">{{stats.saveAmount || '0.00'}}</text>
      </view>
      
      <view class="stats-footer">
        <view class="stats-item">
          <view class="icon-ticket"></view>
          <text>累计找券 {{stats.couponCount || '0'}} 张</text>
        </view>
      </view>
    </view>
  </view>

  <view class="main-content">
    
    <!-- Premium Promo Banner -->
    <button class="promo-banner" open-type="share">
      <view class="promo-left">
        <view class="icon-gift-indigo"></view>
        <view class="promo-text">
          <text class="promo-title">邀请好友一起省钱</text>
          <text class="promo-desc">分享小栗鼠，让更多人享受优惠</text>
        </view>
      </view>
      <view class="promo-btn" hover-class="scale-95">邀请</view>
    </button>

    <!-- Recent Footprints (Bento Card) -->
    <view class="bento-card history-card">
      <view class="card-header-flex">
        <text class="card-title">找券足迹</text>
        <view class="history-more" bindtap="goToHistory" hover-class="opacity-80">
          查看全部 <view class="icon-chevron-right-gray-sm"></view>
        </view>
      </view>
      <scroll-view class="history-scroll" scroll-x="true" enable-flex="true">
        <view class="history-item" wx:for="{{recentHistory}}" wx:key="id" hover-class="scale-98">
          <image class="history-img" src="{{item.image}}" mode="aspectFill"></image>
          <view class="history-price">¥{{item.price}}</view>
        </view>
        <!-- Empty placeholder -->
        <view class="history-item history-item-empty" wx:if="{{!recentHistory || recentHistory.length < 4}}" bindtap="goToDiscover">
          <view class="icon-plus-gray"></view>
          <text>去逛逛</text>
        </view>
      </scroll-view>
    </view>

    <!-- Menu List (Bento Card) -->
    <view class="bento-card menu-list-card">
      <view class="menu-item" wx:for="{{menuList}}" wx:key="id" hover-class="menu-hover" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-left">
          <view class="menu-icon-wrap" style="background-color: {{item.iconBg}};">
            <view class="icon-lucide {{item.iconClass}}" style="color: {{item.iconColor}};"></view>
          </view>
          <view class="menu-text-wrap">
            <text class="menu-name">{{item.name}}</text>
            <text class="menu-sub" wx:if="{{item.subname}}">{{item.subname}}</text>
          </view>
        </view>
        <view class="menu-right" wx:if="{{item.hasArrow}}">
          <view class="icon-chevron-right-gray"></view>
        </view>
      </view>
    </view>
    
  </view>

  <!-- Footer -->
  <view class="footer-area">
    <text>小栗鼠 · 纯导购省钱工具 · 免费无广告</text>
  </view>

</view>
