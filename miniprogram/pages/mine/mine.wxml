<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">
  <view class="points-banner" style="padding-top: {{statusBarHeight}}px;">
    <!-- NavBar 区域 (高度 {{navHeight}}px) -->
    <view class="nav-bar" style="height: {{navHeight}}px;">
      <text class="nav-title">个人中心</text>
    </view>
    
    <!-- User Row -->
    <view class="user-row" bindtap="onShowEditModal">
      <view class="avatar">
        <image class="avatar-img" src="{{userInfo.avatarUrl || '/images/icons/avatar_user.png'}}" mode="aspectFill"></image>
      </view>
      <view class="user-info">
        <text class="user-nickname">{{userInfo.nickName || '未登录'}}</text>
        <text class="user-level" wx:if="{{userInfo.level}}">{{userInfo.level}}</text>
      </view>
      <image class="user-arrow" src="/images/icons/chevron_right_white_v2.png" mode="aspectFit"></image>
    </view>
  </view>

  <view class="content-area">
    <!-- Stats Card (按画板 CZZB6: 累计省下在左[橙色], 可用积分在右[黑色], 标签在上, 数值在下) -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-label">累计为您省下 (元)</text>
        <text class="stat-value highlight">{{userInfo.totalSaved || '0.00'}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">当前可用积分</text>
        <text class="stat-value">{{userInfo.availablePoints || '0'}}</text>
      </view>
    </view>

    <!-- Shop Banner (文案严格对齐: 去兑换) -->
    <view class="shop-banner" bindtap="onMenuClick" data-id="shop">
      <view class="shop-icon-box">
        <image class="shop-icon" src="/images/icons/store.png" mode="aspectFit"></image>
      </view>
      <view class="shop-info">
        <text class="shop-title">佳友栈老温 视频号店</text>
        <text class="shop-desc">积分全额兑换 或 积分抵扣换购健康好物</text>
      </view>
      <view class="shop-btn">去兑换</view>
    </view>

    <!-- Invite Card -->
    <button class="invite-card btn-reset" open-type="share">
      <view class="invite-icon-box">
        <image class="invite-icon" src="/images/icons/user_plus.png" mode="aspectFit"></image>
      </view>
      <view class="invite-info">
        <text class="invite-title">邀请好友 一起省钱</text>
        <text class="invite-desc">好友首次查券，各得 500 积分</text>
      </view>
      <image class="invite-arrow" src="/images/icons/chevron_right_invite_v2.png" mode="aspectFit"></image>
    </button>

    <!-- Menu List -->
    <view class="menu-list">
      <block wx:for="{{menuList}}" wx:key="id">
        <view class="menu-item" bindtap="onMenuClick" data-id="{{item.id}}">
          <view class="menu-icon-box" style="background-color: {{item.bg}};">
            <image class="menu-icon" src="{{item.iconPath}}" mode="aspectFit"></image>
          </view>
          <view class="menu-info">
            <text class="menu-title">{{item.title}}</text>
            <text class="menu-desc">{{item.desc}}</text>
          </view>
          <image class="menu-arrow" src="/images/icons/chevron_right_grey_v2.png" mode="aspectFit"></image>
        </view>
        <view class="menu-sep" wx:if="{{index < menuList.length - 1}}"></view>
      </block>
    </view>
  </view>

  <!-- 全局统一按需调用微信授权登录组件 -->
  <auth-modal visible="{{showAuthModal}}" bind:success="onAuthSuccess" bind:cancel="onAuthCancel" />
  
  <!-- 防遮挡占位垫(适配底部原生tabBar高度及安全区) -->
  <view class="safe-area-spacer" style="height: 100rpx; padding-bottom: env(safe-area-inset-bottom);"></view>
</scroll-view>
