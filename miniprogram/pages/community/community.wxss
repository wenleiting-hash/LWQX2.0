page {
  background-color: #F5F5F5;
  height: 100%;
}

.page {
  height: 100%;
}

.content-area {
  padding: 32rpx; /* 16px */
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px spacing */
}

/* Hero Card */
.hero-card {
  width: 100%;
  height: 360rpx; /* 180px */
  border-radius: 28rpx; /* 14px */
  overflow: hidden;
  position: relative;
}

.hero-img {
  width: 100%;
  height: 100%;
  background-color: #EEE;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 40rpx; /* 20px */
  box-sizing: border-box;
}

.hero-text-box {
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 16rpx; /* 8px */
  padding: 24rpx; /* 12px */
  display: flex;
  flex-direction: column;
  align-self: flex-start;
}

.hero-title {
  color: #FFFFFF;
  font-size: 36rpx; /* 18px */
  font-weight: 700;
  margin-bottom: 4rpx;
}

.hero-sub {
  color: #EEEEEE;
  font-size: 26rpx; /* 13px */
}

/* QR Card */
.qr-card {
  background-color: #FFFFFF;
  border-radius: 32rpx; /* 16px */
  padding: 64rpx; /* 32px */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48rpx; /* 24px */
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.qr-tip {
  color: #191919;
  font-size: 32rpx; /* 16px */
  font-weight: 600;
}

.qr-container {
  width: 400rpx; /* 200px */
  height: 400rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx; /* 12px */
  padding: 16rpx; /* 8px */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); /* outer shadow */
}

.qr-code {
  width: 100%;
  height: 100%;
}

.wechat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wechat-info {
  color: #353535;
  font-size: 30rpx; /* 15px */
}

.mini-copy-btn {
  background-color: #FFF0E8;
  border-radius: 24rpx; /* 12px */
  padding: 8rpx 20rpx; /* 4px 10px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-text {
  color: #FF6B35;
  font-size: 24rpx; /* 12px */
  font-weight: 600;
}
