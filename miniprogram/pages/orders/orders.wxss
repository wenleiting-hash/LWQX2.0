page {
  background-color: #F5F5F5;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

/* NavBar */
.nav-container {
  background-color: #FFFFFF;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* Tabs */
.tabs-container {
  display: flex;
  background-color: #FFFFFF;
  padding: 0 32rpx;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab-item {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.tab-text {
  font-size: 30rpx;
  color: #7A7E83;
}

.tab-item.active .tab-text {
  color: #FF6B35;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 6rpx;
  background-color: #FF6B35;
  border-radius: 3rpx;
}

/* 提示条 */
.notice-bar {
  background-color: #FFF0E8;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notice-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 24rpx;
  color: #FF6B35;
  flex: 1;
}

/* 订单列表 */
.order-scroll {
  flex: 1;
  height: 0;
  width: 100%;
}

.order-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.order-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.order-title {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order-points {
  font-size: 34rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.status-pending { color: #FF9500; }
.status-settled { color: #07C160; }
.status-invalid { color: #AAAAAA; }

.order-prices {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.price-original {
  font-size: 22rpx;
  color: #AAAAAA;
  text-decoration: line-through;
}

.price-actual {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.price-save {
  font-size: 22rpx;
  color: #EB2F96;
  background-color: #FFF0F6;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.order-info {
  font-size: 22rpx;
  color: #AAAAAA;
}

.order-status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.tag-pending { color: #FF9500; background-color: #FFF9E6; border-radius: 8rpx; }
.tag-settled { color: #07C160; background-color: #E6F7ED; border-radius: 8rpx; }
.tag-invalid { color: #AAAAAA; background-color: #F5F5F5; border-radius: 8rpx; }

/* ========== 订单详情弹层 ========== */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.detail-sheet {
  background-color: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  padding: 20rpx 48rpx 68rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 拖拽条 */
.handle-bar-wrap {
  display: flex;
  justify-content: center;
  padding: 0 0 4rpx;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  background-color: #E5E5E5;
  border-radius: 4rpx;
}

/* 标题行 */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 统计数据行 */
.stats-row {
  display: flex;
  justify-content: space-between;
  padding: 32rpx 0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.stats-label {
  font-size: 22rpx;
  color: #888888;
}

.stats-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.stats-value--save {
  color: #1A1A1A;
}

.stats-value--points {
  color: #FF6B35;
}

/* 分隔线 */
.sheet-divider {
  height: 1rpx;
  background-color: #F0F0F0;
}

/* 信息行 */
.info-rows {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-label {
  font-size: 28rpx;
  color: #888888;
}

.info-value-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.copy-btn {
  font-size: 24rpx;
  color: #FF6B35;
  padding: 4rpx 16rpx;
  border: 1rpx solid #FF6B35;
  border-radius: 20rpx;
}

.status-text-pending { color: #FF9500; }
.status-text-settled { color: #07C160; }
.status-text-invalid { color: #AAAAAA; }

/* 底部说明 */
.sheet-footer {
  display: flex;
  justify-content: center;
  padding-top: 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #AAAAAA;
}

/* ========== 找回订单入口交互 ========== */
.claim-trigger-btn {
  font-size: 22rpx;
  color: #EB2F96;
  background-color: #FFF0F6;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-left: auto;
}

/* ========== 找回订单弹窗 ========== */
.claim-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.claim-modal {
  width: 540rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.claim-header {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
}

.claim-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.claim-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.claim-input {
  height: 80rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.claim-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 10rpx;
}

.claim-btn-cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.claim-btn-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FF6B35;
  color: #FFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  font-weight: 500;
}


