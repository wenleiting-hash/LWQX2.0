<view class="page">
  <!-- NavBar - 我的订单 -->
  <view class="nav-container" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navHeight}}px;">
      <text class="nav-bar-title">我的订单</text>
    </view>
  </view>

  <!-- 顶置 Tabs -->
  <view class="tabs-container">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab-item {{activeTab === item.id ? 'active' : ''}}"
      bindtap="onTabClick"
      data-id="{{item.id}}"
    >
      <text class="tab-text">{{item.title}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === item.id}}"></view>
    </view>
  </view>

  <!-- 防退款提示 -->
  <view class="notice-bar">
    <image class="notice-icon" src="/images/icons/info_orange.png" mode="aspectFit"></image>
    <text class="notice-text">为防退款，积分将于确认收货后次月20日到账</text>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-scroll">
    <view class="order-list">
      <view class="order-card" wx:for="{{orderList}}" wx:key="id" bindtap="onOrderTap" data-index="{{index}}">
        <image class="order-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="order-main">
          <view class="order-top">
            <view class="order-title">{{item.title}}</view>
            <view class="order-points status-{{item.status}}">{{item.points}}</view>
          </view>
          <view class="order-bottom">
            <view class="order-info">{{item.date}} · 订单尾号 ****{{item.orderId}}</view>
            <view class="order-status-tag tag-{{item.status}}">{{item.statusText}}</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 订单详情弹层 -->
  <view class="detail-overlay" wx:if="{{showDetail}}" bindtap="onCloseDetail">
    <view class="detail-sheet" catchtap="noop">
      <!-- 拖拽条 -->
      <view class="handle-bar-wrap">
        <view class="handle-bar"></view>
      </view>
      <!-- 标题行 -->
      <view class="sheet-header">
        <text class="sheet-title">订单详情</text>
        <view class="sheet-close" bindtap="onCloseDetail">
          <image class="sheet-close-icon" src="/images/icons/close_x_detail.png" mode="aspectFit"></image>
        </view>
      </view>
      <!-- 核心统计数据 -->
      <view class="stats-row">
        <view class="stats-item">
          <text class="stats-label">查券已省（元）</text>
          <text class="stats-value stats-value--save">{{currentOrder.saved}}</text>
        </view>
        <view class="stats-item">
          <text class="stats-label">预估获得积分</text>
          <text class="stats-value stats-value--points">{{currentOrder.points}}</text>
        </view>
      </view>
      <!-- 分隔线 -->
      <view class="sheet-divider"></view>
      <!-- 详情信息行 -->
      <view class="info-rows">
        <view class="info-row">
          <text class="info-label">订单流水号</text>
          <view class="info-value-wrap">
            <text class="info-value">{{currentOrder.orderNo}}</text>
            <text class="copy-btn" bindtap="onCopyOrderNo" data-no="{{currentOrder.orderNo}}">复制</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">下单时间</text>
          <text class="info-value">{{currentOrder.date}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">账目状态</text>
          <text class="info-value status-text-{{currentOrder.status}}">{{currentOrder.statusText}}</text>
        </view>
      </view>
      <!-- 底部说明 -->
      <view class="sheet-footer">
        <text class="footer-text">积分将于确认收货后次月20日到账</text>
      </view>
    </view>
  </view>
</view>
